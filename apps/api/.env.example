# Entorno de ejecucion
NODE_ENV=development
PORT=3000
ZONA_HORARIA=America/Argentina/Mendoza

# Conexion a PostgreSQL
# Usar DATABASE_URL o el conjunto DB_* segun el entorno.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false

# CORS
CORS_ORIGENES_PERMITIDOS=http://localhost:5173,http://localhost:4173,http://localhost:5174,http://localhost:4176,http://localhost:5175

# Autenticacion
JWT_SECRETO_ACCESO=
JWT_DURACION_ACCESO=15m
DURACION_REFRESH_TOKEN=30d
COSTO_HASH_CONTRASENA=12

# Seguridad operacional
RATE_LIMIT_AUTENTICACION_VENTANA_MS=60000
RATE_LIMIT_AUTENTICACION_MAXIMO=10
AUDITORIA_HABILITADA=true
