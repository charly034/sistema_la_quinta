# Entorno E2E — Copiar a .env.e2e y completar con valores reales.
# NUNCA versionar .env.e2e (ya está en .gitignore).

# Base de datos EXCLUSIVA de pruebas (obligatoria)
DATABASE_URL_PRUEBAS=postgresql://usuario:CONTRASENA@localhost:5433/la_quinta_pruebas

# Secreto JWT exclusivo del entorno E2E (distinto del de producción)
JWT_SECRETO_ACCESO=SECRETO_EXCLUSIVO_E2E_NO_PRODUCTIVO

# Usuario E2E (se crea o actualiza automáticamente antes de los tests)
E2E_USUARIO_CORREO=e2e-propietario@laquinta.local
E2E_USUARIO_CONTRASENA=CONTRASENA_E2E_PLACEHOLDER
E2E_USUARIO_NOMBRE=Propietario E2E

# URLs de los servicios E2E
E2E_API_URL=http://localhost:3001
E2E_WEB_URL=http://localhost:5174

# El frontend usa esta variable para apuntar a la API E2E
VITE_API_URL=http://localhost:3001/api/v1
